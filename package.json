{
  "name": "proofbox",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r build",
    "dev": "vp run web#dev",
    "release:version": "changeset version && node scripts/sync-version.mjs && uv lock --project apps/api && uv lock --project apps/printer && uv lock --project apps/vision",
    "version:check": "node scripts/sync-version.mjs --check"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.22.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
